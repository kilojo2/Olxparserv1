# ============================================================
#  OLX Rent Parser — пример конфигурации
#  Скопируйте в файл .env и заполните нужными значениями
# ============================================================

# --- Город (можно по-русски или по-украински) ---
CITY=Хмельницький

# --- Парсер ---
# Сколько страниц объявлений парсить за один прогон
PAGES_PER_RUN=2
# Интервал между прогонами в минутах
INTERVAL_MINUTES=120
# Сохранять только объявления младше N дней (возраст < N)
MAX_AGE_DAYS=2

# --- Браузер ---
# true = headless (для Railway), false = видимый браузер (локально)
HEADLESS=true

# --- База данных ---
# Локально (по умолчанию) — SQLite
DATABASE_URL=sqlite:///./olx.db
# На Railway — PostgreSQL (Railway предоставляет переменную DATABASE_URL автоматически):
# DATABASE_URL=postgresql://user:password@host:5432/railway

# --- Прокси (опционально) ---
PROXY_ENABLED=false

# Способ 1: готовый URL (поддерживаются http/https/socks4/socks5, с авторизацией)
# PROXY_URL=socks5://user:password@host:1080

# Способ 2: отдельными полями
# PROXY_PROTOCOL=http
# PROXY_HOST=127.0.0.1
# PROXY_PORT=8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=pass

# Ротация списка прокси (через запятую, формат полных URL)
# PROXY_LIST=socks5://u1:p1@h1:1080,http://u2:p2@h2:8080

# --- OLX ---
OLX_BASE_URL=https://www.olx.ua

# --- Админ-пароль (для раздела /settings) ---
ADMIN_PASSWORD=changeme

# --- Telegram (подключается через сайт /settings) ---
# API ID и API Hash можно задать здесь как фолбэк (или ввести на сайте):
# TELEGRAM_API_ID=34682111
# TELEGRAM_API_HASH=8aa1c674e979d3be51f9e937fc7c5590
